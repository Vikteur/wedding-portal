{
  "_comment": "Per-agent write/command fences, ported from the Copilot agents' allowedFilePaths/commandAllowlist. Enforced by scripts/scope-guard.sh (PreToolUse). allowedFilePaths absent = any path; [] = no writes. Entry ending in '/' = directory prefix; otherwise exact path or bash glob. commandAllowlist = allowed command prefixes.",
  "agents": {
    "analyst": {
      "allowedFilePaths": [
        "docs/"
      ],
      "commandAllowlist": [
        "./gradlew test",
        "./gradlew integrationTest",
        "./gradlew check",
        "npm test",
        "npm run test"
      ]
    },
    "closeout": {
      "allowedFilePaths": [
        "docs/",
        "CHANGELOG.md"
      ],
      "commandAllowlist": [
        "scripts/cleanup-parts.sh",
        "git status",
        "git log",
        "git branch",
        "gh pr view",
        ".archon/scripts/retro-commit.sh",
        "git diff",
        "./gradlew test",
        "./gradlew integrationTest",
        "./gradlew check",
        "npm test",
        "npm run test"
      ]
    },
    "contract-agent": {
      "allowedFilePaths": [
        "openapi.yaml",
        "docs/"
      ],
      "commandAllowlist": [
        "git add",
        "git commit",
        "git push",
