# Shell scripts run under bash in Archon worktrees: a CRLF checkout breaks them.
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
# The Flyway checksum is computed over the bytes: a CRLF checkout on Windows would change it.
*.sql text eol=lf
# Properties files are read by the build: no CRLF.
*.properties text eol=lf
# Git hooks have no .sh extension and run under bash: no CRLF.
.githooks/* text eol=lf
