# Shell scripts run under bash in Archon worktrees: a CRLF checkout breaks them.
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
# The Flyway checksum is computed over the bytes: a CRLF checkout on Windows would change it.
*.sql text eol=lf
# gradle.properties is read by the build and by .github/scripts/contract-pin.sh: no CRLF.
*.properties text eol=lf
