{{!
  Resource spec over HTTP: @QuarkusTest + RestAssured, the use case replaced by @InjectMock
  (it must be an @ApplicationScoped bean; @InjectMock needs the io.quarkus:quarkus-junit5-mockito test dependency).
  Add @TestSecurity when the endpoint needs a user.
  Target: <capability>-adapter/src/test/java/<package path>/adapter/controller/<Name>ControllerTest.java
  Vars:   package, Name, UseCase, useCase, OperationId (PascalCase), Domain, fixture, path (URL), expectedJson
}}
package {{package}}.adapter.controller;

import com.fasterxml.jackson.databind.ObjectMapper;
import {{package}}.domain.{{Domain}}Mother;
import {{package}}.usecase.{{UseCase}};
import io.quarkus.test.InjectMock;
import io.quarkus.test.junit.QuarkusTest;
import jakarta.inject.Inject;
import org.junit.jupiter.api.Test;

import static io.restassured.RestAssured.given;
import static org.assertj.core.api.Assertions.assertThat;
import static org.mockito.Mockito.when;

@QuarkusTest
class {{Name}}ControllerTest {

    @InjectMock
    {{UseCase}} {{useCase}};

    @Inject
    ObjectMapper objectMapper;

    @Test
    void givenExisting{{Domain}}_when{{OperationId}}_thenReturnOk() throws Exception {
        when({{useCase}}.execute()).thenReturn({{Domain}}Mother.{{fixture}}());

        var body = given()
                .when().get("{{{path}}}")
                .then().statusCode(200)
                .extract().asString();

        assertThat(objectMapper.readTree(body)).isEqualTo(objectMapper.readTree("""
                {{{expectedJson}}}
                """));
    }
}
