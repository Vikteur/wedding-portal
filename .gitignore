# Build outputs are anchored to the root and module directories, so source packages named `build` stay tracked.
/build/
/*/build/
/out/
/*/out/
.gradle/
.kotlin/
.idea/
*.iml

/contract/

# The audit-log hook (.claude/hooks) writes here.
/.apm-audit/

# The scaffold renderer (scripts/scaffold.sh) installs here from its lockfile.
/scripts/scaffold/node_modules/
/scripts/contract-db-parity/node_modules/
